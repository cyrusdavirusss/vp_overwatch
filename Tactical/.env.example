# ══════════════════════════════════════════════════════════════════════════════
# VP Overwatch — environment template.  Copy to .env.local and fill server-side.
# SECURITY: nothing secret may go in a NEXT_PUBLIC_* var — those are inlined into
# client JS. Provider keys, DB creds, auth secrets, SMS creds are SERVER-ONLY and
# are read only by the Next server + the ingestion worker.
# ══════════════════════════════════════════════════════════════════════════════

# ── Provider selection ────────────────────────────────────────────────────────
# Which aviation data source the ingestion worker uses. 'adsbexchange' resolves
# registration->hex automatically but needs a paid key; 'opensky' is free
# (anonymous, or OAuth2 for higher limits) but cannot resolve reg->hex, so you
# must supply each aircraft's Mode-S hex via ADSB_HEX_<REG> below.
ADSB_PROVIDER=opensky              # opensky (keyless, default) | adsbexchange (needs key)

# OpenSky Network (server-only; used only when ADSB_PROVIDER=opensky).
# Anonymous works with no creds (~400 credits/day). OAuth2 client credentials
# raise the budget (~4000/day). Non-commercial license.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Mode-S hex overrides (reg -> icao24), required for OpenSky since its live API
# is hex-keyed. One per tracked registration ('-' becomes '_'), lowercase hex:
#   ADSB_HEX_VH_PVO=7c....
ADSB_HEX_VH_PVO=
ADSB_HEX_VH_PVP=
ADSB_HEX_VH_PVQ=
ADSB_HEX_VH_PVE=

# ── ADS-B Exchange (server-only; used by the ingestion worker ONLY) ───────────
# v2 Enterprise gateway. The browser never calls the provider.
ADSB_EXCHANGE_API_KEY=
ADSB_INGESTION_MODE=rest              # streaming | rest  (rest = one batched cycle)
ADSB_REST_INTERVAL_SECONDS=30
ADSB_FRESH_SECONDS=60                 # <= fresh → live
ADSB_UNAVAILABLE_SECONDS=300          # > this → unavailable (between = stale)
# Movement-confirmation thresholds (helicopter-safe; multi-observation debounce).
ADSB_AIRBORNE_ALT_FT=400
ADSB_GROUND_ALT_FT=150
ADSB_AIRBORNE_SPEED_KT=40
ADSB_GROUND_SPEED_KT=20
ADSB_CONFIRM_OBSERVATIONS=2
# Set ADSB_FAKE=1 to run the worker against fixtures (no key/network) for testing.

# ── Durable shared state (server-only) ────────────────────────────────────────
DATABASE_URL=postgres://vp_overwatch:CHANGE_ME@127.0.0.1:5432/vp_overwatch
# REDIS_URL is optional (acceleration only; Postgres is the source of truth).
REDIS_URL=

# ── Auth / sessions (server-only) ─────────────────────────────────────────────
# 32+ random bytes. Used as a password pepper and to protect sessions.
AUTH_SECRET=
SESSION_TTL_SECONDS=2592000           # 30 days
# Admin token gating the DETAILED /api/dashboard/health (public healthz stays minimal).
ADMIN_TOKEN=
# Set to 'true' ONLY when a reverse proxy fronts the app and appends a
# trustworthy X-Forwarded-For. When unset/false the app treats client IPs as
# unidentifiable and rate-limits by account/email instead of IP (avoids both
# spoofing and a global throttle). Direct LAN/Tailscale exposure → leave false.
TRUSTED_PROXY=false

# ── Location & proximity alerts ───────────────────────────────────────────────
LOCATION_EXPIRY_SECONDS=600           # stored device location expires after this
PROXIMITY_ENTER_METRES=30000          # fire proximity_enter at/inside this
PROXIMITY_EXIT_METRES=33000           # re-arm only past this (anti-flap)

# ── Notification delivery (OFF until real providers are configured) ───────────
# Engine records deliveries regardless; these gate ACTUAL sending.
PUSH_NOTIFICATIONS_ENABLED=false
SMS_NOTIFICATIONS_ENABLED=false
# SMS via Twilio (only used when SMS_NOTIFICATIONS_ENABLED=true AND user consented)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── MapLibre basemap (client-safe; keyless demo fallback if unset) ────────────
NEXT_PUBLIC_PMTILES_URL=
NEXT_PUBLIC_MAP_GLYPHS_URL=
NEXT_PUBLIC_MAP_SPRITE_URL=
NEXT_PUBLIC_HOME_LAT=
NEXT_PUBLIC_HOME_LNG=
