# ── MapLibre basemap (Protomaps) ─────────────────────────────────────────
# Self-hosted Protomaps PMTiles archive for the dark vector basemap.
# Use a Victoria or Australia extract, not a global tileset.
# If unset, the app falls back to the hosted Protomaps demo basemap so
# preview still renders (keyless).
NEXT_PUBLIC_PMTILES_URL=

# Glyph (font) PBF endpoint, with {fontstack}/{range} placeholders.
# Defaults to the keyless Protomaps basemaps-assets CDN when unset.
NEXT_PUBLIC_MAP_GLYPHS_URL=

# Sprite base URL (no extension; MapLibre appends .json/.png and @2x).
# Defaults to the keyless Protomaps v4 dark sprite when unset.
NEXT_PUBLIC_MAP_SPRITE_URL=

# ── Home / default location ──────────────────────────────────────────────
# Map centre used when no precise GPS fix is available. Desktop browsers
# geolocate by IP (often km off), so set this to your area for a sane default.
# Defaults to Melbourne CBD if unset.
NEXT_PUBLIC_HOME_LAT=
NEXT_PUBLIC_HOME_LNG=

# ── Hermes voice alerts (Bland AI) ───────────────────────────────────────
# Outbound safety-awareness calls are placed via Bland AI. If BLAND_API_KEY is
# unset, Hermes runs in DRY-RUN mode: it logs the briefing it *would* speak
# instead of dialing. Calls are also only ever placed to subscribers who hold a
# granted consent record (see ConsentRecord in lib/notifications.ts) — automated
# voice calls require provable opt-in (AU Do Not Call Register / Spam Act, and
# Bland/carrier policy). Do not bypass the consent gate.
BLAND_API_KEY=
# Bland voice id (default "nat") and model (default "enhanced").
BLAND_VOICE=
BLAND_MODEL=
# Optional verified caller-ID number in E.164, if provisioned on the account.
BLAND_FROM_NUMBER=

# ── Twilio (fallback voice transport) ────────────────────────────────────
# Used only if Hermes/Bland is unconfigured or a Bland call hard-fails.
# Static text-to-speech, no conversational agent.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
