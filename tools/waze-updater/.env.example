# VP-Overwatch Waze Updater Configuration
# Copy this file to .env and fill in the values below

# VP-Overwatch app URL (Tailscale IP recommended)
# Example: http://100.94.31.125:3100
API_URL=

# Relay authentication secret
# Must match WAZE_RELAY_SECRET environment variable on the app server
RELAY_SECRET=

# Polling interval in seconds (minimum 30)
# Default: 600 (10 minutes)
POLL_SECONDS=600

# Log level: info, warn, error
# Default: info
LOG_LEVEL=info