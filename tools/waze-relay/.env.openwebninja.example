# VP-Overwatch Waze Relay Configuration (OpenWebNinja API)
# Copy to .env.openwebninja and adjust values

# VP-Overwatch API endpoint
API_URL=http://100.94.31.125:3100

# Relay secret (must match WAZE_RELAY_SECRET on the app side)
RELAY_SECRET=your-relay-secret-here

# OpenWebNinja API key
# Get your key at: https://app.openwebninja.com/api/waze
# Free tier available for testing
OPENWEBNINJA_API_KEY=your-api-key-here

# Polling interval in seconds (minimum 30)
POLL_SECONDS=600