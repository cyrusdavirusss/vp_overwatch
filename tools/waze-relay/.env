# VP-Overwatch Waze relay config

# The VP-Overwatch app on the Kali box, over Tailscale (proven reachable from
# this Windows machine). Use the Tailscale IP so it works regardless of LAN.
API_URL=http://100.94.31.125:3100

# Must match WAZE_RELAY_SECRET on the app side. The app currently accepts the
# default 'dev-secret' (no override set). Keep these two in sync.
RELAY_SECRET=dev-secret

# Only used in loop mode (node relay.mjs without --once). The Scheduled Task
# uses --once + a 10-minute trigger, so this is ignored there.
POLL_SECONDS=600
