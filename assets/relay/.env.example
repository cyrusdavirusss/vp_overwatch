# Copy this file to `.env` and fill in the values.

# Your tracker's public URL (no trailing slash). The .replit.dev URL works
# while developing; once deployed, switch to your .replit.app URL.
API_URL=https://your-tracker.replit.app

# Must exactly match the WAZE_RELAY_SECRET set in Replit Secrets.
RELAY_SECRET=paste-the-same-secret-here

# How often to fetch Waze (seconds). Minimum 30, default 60.
POLL_SECONDS=60
