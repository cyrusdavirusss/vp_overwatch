+/* =========================================================================
+   VP OVERWATCH · Modern tactical chrome
+   The map remains the primary surface. This layer modernises only the UI
+   surrounding it: controls, cards, sheets, buttons, status chrome and
+   interactive surfaces.
+   ========================================================================= */
+
+button,
+input,
+select,
+textarea {
+  font: inherit;
+}
+
+button {
+  -webkit-tap-highlight-color: transparent;
+}
+
+.vp-icon {
+  flex: 0 0 auto;
+}
+
+/* Make existing primitive controls feel quieter and more premium. */
+.btn {
+  min-height: 38px;
+  border-radius: 10px;
+  border-color: var(--border);
+  box-shadow: 0 1px 2px rgba(0,0,0,.22);
+}
+
+.btn-primary {
+  background: linear-gradient(180deg, #1D80DE 0%, #1267B7 100%);
+  box-shadow:
+    0 1px 0 rgba(255,255,255,.08) inset,
+    0 6px 18px rgba(22,119,210,.18);
+}
+
+.btn-primary:hover {
+  background: linear-gradient(180deg, #2D8CFF 0%, #1677D2 100%);
+}
+
+.btn-secondary {
+  background: rgba(16,26,36,.92);
+  border-color: #2A3D4C;
+}
+
+.btn-secondary:hover {
+  background: #182A38;
+  border-color: #3B5060;
+}
+
+.btn-ghost:hover {
+  background: rgba(45,140,255,.07);
+}
+
+.card {
+  background:
+    linear-gradient(180deg, rgba(255,255,255,.018), rgba(255,255,255,0)),
+    rgba(16,26,36,.94);
+  border-color: #263746;
+  box-shadow: 0 10px 28px rgba(0,0,0,.20);
+}
+
+.chip-live {
+  background: rgba(45,140,255,.09);
+  color: #65AAFF;
+}
+
+.chip-aircraft {
+  background: rgba(190,205,216,.08);
+  color: #D5DFE6;
+}
+
+/* Avoid making the whole interface glow. Reserve blue glow for active state. */
+.dot-pulse::after {
+  animation-duration: 2.2s;
+  opacity: .28;
+}
+
+::selection {
+  background: rgba(45,140,255,.28);
+  color: #fff;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  *,
+  *::before,
+  *::after {
+    animation-duration: .01ms !important;
+    animation-iteration-count: 1 !important;
+    transition-duration: .01ms !important;
+    scroll-behavior: auto !important;
+  }
+}
+
 /* FOCUS RING — keyboard only */
 :focus-visible {
   outline: 2px solid var(--blue);
