# ── Required secrets (use long random strings) ───────────────────
POSTGRES_PASSWORD=change-me-strong-db-password
WAZE_RELAY_SECRET=change-me-relay-secret
GPS_RELAY_SECRET=change-me-gps-secret
AUTH_SECRET=change-me-auth-secret-min-32-chars

# ── ADS-B provider (OpenSky OAuth2 — free ~4000 credits/day) ─────
ADSB_PROVIDER=opensky
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# ── Waze relay (POLICE-only, Victoria) ───────────────────────────
# OpenWebNinja managed API key (paid). Being replaced by a free API.
OPENWEBNINJA_API_KEY=
POLL_SECONDS=300

# ── Map basemap ──────────────────────────────────────────────────
# Blank = hosted Protomaps demo basemap (works out of the box).
# To self-host Victoria offline: put Tactical/public/victoria.pmtiles
# and set NEXT_PUBLIC_PMTILES_URL=/victoria.pmtiles
NEXT_PUBLIC_PMTILES_URL=
NEXT_PUBLIC_HOME_LAT=-37.934337
NEXT_PUBLIC_HOME_LNG=145.180479
